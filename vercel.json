{
  "version": 2,
  "builds": [
    {
      "src": "halaman.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin.html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/halaman.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
